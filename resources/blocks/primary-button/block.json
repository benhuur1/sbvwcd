{
    "name": "sage/primary-button",
    "title": "Primary Button",
    "category": "design",
    "icon": "button",
    "description": "A customizable button with link, text and style options",
    "textdomain": "sage",
    "editorScript": "file:./block.jsx",
    "style": "file:./block.css",
    "render": "file:./block.php",
    "attributes": {
        "label": {
            "type": "string",
            "default": "Click here"
        },
        "link": {
            "type": "string",
            "default": "#"
        },
        "target": {
            "type": "string",
            "default": "_self",
            "enum": ["_self", "_blank"]
        },
        "version": {
            "type": "string",
            "default": "primary-button",
            "enum": ["primary-button", "secondary-large"]
        }
    }
}